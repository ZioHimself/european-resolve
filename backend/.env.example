# Backend API Environment Variables
#
# Cloud Run service account needs Editor access on the Google Spreadsheet.
# Local development: run `gcloud auth application-default login` for Sheets auth.
# CORS_ORIGINS must include the exact frontend origin (with protocol, no trailing slash).

# Cloud Run sets this automatically
PORT=8080

# Google Sheets document ID (from the spreadsheet URL)
SPREADSHEET_ID=your-spreadsheet-id-here

# CORS (comma-separated origins, with protocol)
CORS_ORIGINS=https://european-resolve.org,http://localhost:3000

# WhyDonate campaign URL (used in confirmation emails)
WHYDONATE_WIDGET_URL=https://whydonate.com/en/fundraising/run-for-ukraine-2026

# WhyDonate orders API (sync-whydonate-tracking, process-wd-pending alias)
WHYDONATE_CAMPAIGN_SLUG=run-for-ukraine-2026-brussels
WHYDONATE_ORDERS_API_BASE=https://donation.whydonate.dev

# Google Drive folder ID for photo uploads
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id-here

# Google Drive OAuth2 credentials (for photo uploads as a real user)
# Service accounts have zero Drive storage quota — use OAuth2 refresh token instead.
# Regenerate locally (auto-capture on port 80; may need sudo):
#   sudo npm run refresh-drive-oauth -- serve --credentials /path/to/client_secret.json --open
# Manual paste only: add --manual
# Push to GitHub after exchange: add --update-github-secrets [--deploy] (requires gh auth login)
DRIVE_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
DRIVE_OAUTH_CLIENT_SECRET=GOCSPX-your-client-secret
DRIVE_OAUTH_REFRESH_TOKEN=1//your-refresh-token

# Fundraising goal in EUR (default 3000)
GOAL_EUR=3000

# Event lifecycle status: "active" (default) allows registrations and writes;
# "completed" blocks new registrations, fundraiser writes, and donor wall entries.
EVENT_STATUS=active

# SMTP (registration confirmation emails via mailbox.org)
SMTP_HOST=smtp.mailbox.org
SMTP_PORT=465
SMTP_USER=serhiy.onyshchenko@european-resolve.org
SMTP_PASS=your-app-password-here
SMTP_FROM="Run for Ukraine 2026 <serhiy.onyshchenko@european-resolve.org>"
SMTP_REPLY_TO=info@european-resolve.org

# Node environment
NODE_ENV=development

# ---
# GitHub Actions repository variables (set in Settings > Secrets and variables > Actions > Variables):
#
# WIF_PROVIDER        — Workload Identity Federation provider resource name
# WIF_SERVICE_ACCOUNT  — GCP service account email for deployments
# GCP_PROJECT          — GCP project ID (e.g. dev-serhiy)
# GCP_REGION           — GCP region (e.g. europe-west1)
# EVENT_STATUS         — set to "completed" only at post-event closure time (blocks API writes)
