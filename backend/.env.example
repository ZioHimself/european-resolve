# Backend API Environment Variables
#
# Cloud Run service account needs Editor access on the Google Spreadsheet.
# Local development: run `gcloud auth application-default login` for Sheets auth.
# CORS_ORIGINS must include the exact frontend origin (with protocol, no trailing slash).

# Cloud Run sets this automatically
PORT=8080

# Google Sheets document ID (from the spreadsheet URL)
SPREADSHEET_ID=your-spreadsheet-id-here

# CORS (comma-separated origins, with protocol)
CORS_ORIGINS=https://european-resolve.org,http://localhost:3000

# WhyDonate campaign URL for donation widget
WHYDONATE_WIDGET_URL=https://whydonate.com/en/fundraising/run-for-ukraine-2026

# Google Drive folder ID for photo uploads
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id-here

# Fundraising goal in EUR (default 3000)
GOAL_EUR=3000

# Node environment
NODE_ENV=development

# ---
# GitHub Actions repository variables (set in Settings > Secrets and variables > Actions > Variables):
#
# WIF_PROVIDER        — Workload Identity Federation provider resource name
# WIF_SERVICE_ACCOUNT  — GCP service account email for deployments
# GCP_PROJECT          — GCP project ID (e.g. dev-serhiy)
# GCP_REGION           — GCP region (e.g. europe-west1)
