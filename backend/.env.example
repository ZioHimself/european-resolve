# SMTP (mailbox.org or similar)
SMTP_HOST=smtp.mailbox.org
SMTP_PORT=465
SMTP_USER=your-user@european-resolve.org
SMTP_PASS=your-app-password-here
SMTP_FROM="Run for Ukraine 2026 <noreply@european-resolve.org>"
SMTP_REPLY_TO=info@european-resolve.org

# Optional: path to registrations TSV export (default: /tmp/registrations.tsv)
# DEPLOYMENT_RECIPIENTS_TSV=/tmp/registrations.tsv
